<resources>

    <style name="Base.Theme.MiceWine" parent="Theme.Material3.DynamicColors.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/darker_gray</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnBackground">#000000</item>
        <item name="colorOnSurface">#000000</item>
        <item name="popupMenuBackground">@drawable/menu_bg</item>
    </style>

    <color name="textColor">#000000</color>

    <style name="Base.Theme.MiceWine.FullScreen" parent="Theme.Material3.DynamicColors.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/darker_gray</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnBackground">#000000</item>
        <item name="colorOnSurface">#000000</item>
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#000000</item>

        <item name="colorPrimaryContainer">#FFFFFF</item>
        <item name="colorOnPrimaryContainer">#000000</item>
        <item name="popupMenuBackground">@drawable/menu_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.MiceWine" parent="Base.Theme.MiceWine" />
    <style name="Theme.MiceWine.FullScreen" parent="Base.Theme.MiceWine.FullScreen" />

    <!-- Dark dialogs matching the web shell (#12131A background, Vortex purple accent) -->
    <style name="Theme.Cyclone.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">#1B1C24</item>
        <item name="android:textColorPrimary">#E9EAEC</item>
        <item name="android:textColorSecondary">#B7B9C0</item>
        <item name="android:colorAccent">#8A7DFF</item>
    </style>

</resources>