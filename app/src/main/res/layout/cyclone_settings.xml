<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Framerate"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_fps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton android:id="@+id/fps_30" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30" />
            <RadioButton android:id="@+id/fps_45" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="45" />
            <RadioButton android:id="@+id/fps_60" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60" />
            <RadioButton android:id="@+id/fps_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unlimited" />
        </RadioGroup>

        <TextView
            android:id="@+id/lbl_sens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Camera sensitivity"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sb_sens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="290" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Music volume"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sb_vol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Graphics"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_gfx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton android:id="@+id/gfx_720" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Performance (720p)" />
            <RadioButton android:id="@+id/gfx_1080" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quality (1080p)" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Extra buttons"
            android:textStyle="bold" />

        <CheckBox android:id="@+id/cb_e" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="E (interact)" />
        <CheckBox android:id="@+id/cb_r" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R" />
        <CheckBox android:id="@+id/cb_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Number keys 1-3" />

        <TextView
            android:id="@+id/tv_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Temperature: --" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:text="Framerate, graphics and buttons apply the next time you join."
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
